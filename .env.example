# Live search (configure one provider; never expose these with NEXT_PUBLIC_)
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Bounded research pipeline
RESEARCH_MAX_QUERIES=28
RESEARCH_RESULTS_PER_QUERY=6
RESEARCH_MAX_PROVIDER_CALLS=28
RESEARCH_MAX_COUNTEREVIDENCE_SEARCHES=2
RESEARCH_MAX_AGENT_CALLS=0
RESEARCH_MAX_PROVIDER_SPEND_CREDITS=28
RESEARCH_MAX_CONCURRENCY=3
RESEARCH_MAX_RETRIES_PER_SEARCH=1
RESEARCH_COMPARISON_MAX_PROVIDER_CALLS=30
RESEARCH_MAX_CANDIDATES=30
RESEARCH_MAX_SURVIVOR_ITERATIONS=1
RESEARCH_MAX_EXPANSION_BRANCHES=5
RESEARCH_MIN_CREDIBLE_COMPETITORS=5
RESEARCH_COMPETITOR_QUERIES_PER_CANDIDATE=2
RESEARCH_TIMEOUT_MS=15000
RESEARCH_MAX_RUN_DURATION_MS=75000
RESEARCH_CACHE_TTL_SECONDS=86400
RESEARCH_HISTORY_TTL_SECONDS=31536000
RESEARCH_PER_USER_DAILY_LIMIT=10
RESEARCH_PER_USER_MONTHLY_LIMIT=100

# Strict validation evidence gate (research survivors are not called validated without external validation)
EVIDENCE_GATE_MIN_PAIN_SIGNALS=3
EVIDENCE_GATE_MIN_SPEND_SIGNALS=2
EVIDENCE_GATE_MIN_COMPETITORS=3
EVIDENCE_GATE_MIN_SEGMENTS=1
EVIDENCE_GATE_MIN_TIMING_SIGNALS=1
EVIDENCE_GATE_MIN_SOURCE_TYPES=3
EVIDENCE_GATE_MIN_CITATION_COVERAGE=0.85
EVIDENCE_GATE_MAX_FATAL_RISKS=0

# Remote MCP public cost and abuse protection
MCP_RATE_LIMIT_PER_HOUR=20
MCP_GLOBAL_DAILY_RESEARCH_LIMIT=50
MCP_GLOBAL_MONTHLY_RESEARCH_LIMIT=500
MCP_MAX_CONCURRENT_RESEARCH=2
MCP_CONCURRENCY_LEASE_SECONDS=90
MCP_FALSIFICATION_MAX_QUERIES=4
# Local/preview escape hatch only; leave false for public multi-instance Vercel deployments.
MCP_ALLOW_INSTANCE_LOCAL_PUBLIC=false

# Optional durable/distributed storage and counters (recommended on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional for programmable clients. Leave unset for authless Claude browser connectors.
NOVELTY_MCP_ACCESS_TOKEN=

# Claude Code's secondary direct-helper fallback
NOVELTY_RESEARCH_API_URL=https://novelty-engine.com/api/research
# Optional Claude Code helper default: fast, standard, or deep.
NOVELTY_RESEARCH_DEPTH=standard
